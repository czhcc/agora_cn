# Agora 中文运行配置示例
# 依据本地已使用的配置整理，密钥、密码、服务地址和模型路径均已脱敏。
# 使用方法：复制到工程根目录的 .env，按实际环境填写；已有 .env 请先备份。
# 本文件不会自动加载；不要将填写了真实密钥的 .env 提交到版本库。

# ===== 服务端与访问保护 =====
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=false

# 必填：生成独立随机值，分别用于会话签名和操作员登录。
# 生成命令（执行两次，各取一个值）：
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
AGORA_AUTH_TOKEN=

# 必填：生成两个 Fernet 密钥，分别填入下面两个配置。
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 已有安装必须保留原值；更换后可能无法解密之前保存的提供商密钥等数据。
AGORA_SECRET_KEY=
AGORA_FERNET_KEY=

# ===== Neo4j 图数据库 =====
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password

# ===== Redis 事件总线 =====
# 按实际密码修改；密码含 @、:、/ 等字符时需进行 URL 编码。
EVENT_BUS_BACKEND=redis
REDIS_URL=redis://:replace-with-redis-password@127.0.0.1:6379/5

# ===== 文本模型：OpenAI 兼容接口 =====
# 下方 IP 为示例地址，请替换成你的模型服务地址，保留 /v1。
LLM_API_KEY=replace-with-llm-api-key
LLM_BASE_URL=http://192.168.1.100:4002/v1
LLM_MODEL_NAME=qwen3.8-flash-next

# 兼容仍读取 OPENAI_* 的依赖，与上面的文本模型配置保持一致。
# python-dotenv 支持 ${变量名} 引用，无需填写第二份密钥。
OPENAI_API_KEY=${LLM_API_KEY}
OPENAI_API_BASE_URL=${LLM_BASE_URL}

# ===== 向量模型：OpenAI 兼容 Embeddings 接口 =====
# 填写 /v1 基础地址，不要填写完整的 /v1/embeddings 路径。
# 下方 IP 为示例地址；若服务需要鉴权，请填写实际 EMBEDDING_API_KEY。
EMBEDDING_BASE_URL=http://192.168.1.101:8083/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=unused
VECTOR_DIM=1024

# ===== 元数据与模型配置存储 =====
AGORA_METADATA_BACKEND=legacy
AGORA_LLM_PROFILE_BACKEND=sqlite

# ===== 中文生成 =====
# 智能体画像、模拟发言和访谈所使用的默认语言。
AGENT_LANGUAGE=zh
# 报告生成语言；个人资料中的“报告语言”目前尚未替代此项。
REPORT_LANGUAGE=Simplified Chinese
# 界面语言在页面语言切换器中选择“简体中文”，不由 .env 设置。
# 已有运行和已生成内容不会因修改这些设置自动翻译。

# ===== 可选：本地 TwHIN-BERT 社交模拟模型 =====
# 指向完整模型目录；Windows 推荐使用正斜杠，也可填写 Linux 绝对路径。
# 填写后优先加载本地模型；留空则沿用原有 Hugging Face 缓存/下载方式。
# 示例：D:/models/twhin-bert-base 或 /opt/models/twhin-bert-base
AGORA_TWHIN_BERT_MODEL_DIR=
